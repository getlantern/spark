[Unit]
Description=spark dns-tunnel-server (ADR 0011)
After=network-online.target
Wants=network-online.target

[Service]
Environment=RUST_LOG=info
# The PSK is read from a root-only file at start (kept off the command line / out of `ps`).
# Log hygiene: the server emits only a content-free "listening" line — never the zone, PSK, or IPs.
ExecStart=/bin/sh -c 'exec /usr/local/bin/dns-tunnel-server --zone {{ zone }} --psk "$(cat /etc/spark-dns/psk)" --bind {{ bind }} --idle-secs {{ idle_secs }}'
Restart=always
RestartSec=2
# Light hardening (the process only needs the UDP socket + the PSK file).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/spark-dns

[Install]
WantedBy=multi-user.target
