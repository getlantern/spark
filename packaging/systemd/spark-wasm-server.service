[Unit]
Description=spark dynamic-transport exit server (ADR 0013 §7)
Documentation=https://github.com/getlantern/spark/blob/main/docs/wasm-exit-deployment-design.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# `run --config` rather than flags: the provisioning pipeline delivers settings by writing one file
# and restarting the unit, and the config carries `k_srv` — a secret that has no business in an
# ExecStart line, where any local `ps` would read it.
# %d is the unit's private credentials directory. systemd reads the file below as ROOT and stages a
# copy there, owned by the service user and mode 0400 — which is what makes DynamicUser workable at
# all here: the provisioning pipeline writes /etc/spark-wasm-server/config.json as root 0600 inside a
# 0700 directory (it carries `k_srv`), and a transient unprivileged user cannot traverse to it, let
# alone read it. The service could not read its own config, so it never bound its port and the
# reachability gate failed the route — first observed in prod on 2026-08-17.
#
# The alternative fixes are worse: dropping DynamicUser gives the wasm host root, and loosening the
# file to 0644 publishes the side-door secret to every local account.
ExecStart=/usr/sbin/spark-wasm-server run --config %d/config
LoadCredential=config:/etc/spark-wasm-server/config.json
Restart=on-failure
RestartSec=2

# Unlike the client daemon, an exit creates no TUN device and edits no routes, so it needs no
# privilege at all — only the ability to bind its listen port. `DynamicUser` gives it a transient
# unprivileged identity with no home and no shell, which matters more here than on a client: this
# process runs a delivered WebAssembly module and terminates untrusted connections.
DynamicUser=yes
# The bundle store. `StateDirectory` creates /var/lib/spark-wasm-server owned by the dynamic user,
# which is the one place this service needs to write.
StateDirectory=spark-wasm-server
StateDirectoryMode=0700
# 8333 is unprivileged, but an exit fronting 443 is a legitimate deployment, so grant just the one
# capability rather than making the operator choose between root and a port.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. None of these are load-bearing for the transport; they bound the blast radius of a
# module that escapes the wasmi sandbox, which is the threat this binary uniquely carries.
#
# PARTIALLY VERIFIED: first started under systemd on a real host 2026-08-17. What failed there was
# not this block but the config being unreadable under DynamicUser (see LoadCredential above). These
# directives themselves are still unproven against a *working* start, so if the unit fails after the
# credential fix, suspect `SystemCallFilter` and `MemoryDenyWriteExecute` first — relaxing either
# costs nothing functional.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
# wasmi is an interpreter, not a JIT (the reason it is iOS-safe), so the delivered module never needs
# writable-executable pages — which makes this exactly the mitigation to apply to a process whose job
# is running code somebody else wrote.
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
