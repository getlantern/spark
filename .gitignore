# Rust build output
/target
/spark-sharing/target
# `wasm-server` is its own workspace (see Cargo.toml), so it has its own build dir that the
# root-anchored `/target` above does not cover.
/wasm-server/target
**/*.rs.bk

# Release packaging output (DMGs, tarballs, etc. — built by packaging/ scripts + CI)
/dist

# Cargo.lock is intentionally tracked: this workspace ships binaries, not just a library.

# Live fetched config with real secrets — copied in for manual transport diagnostics, never commit.
config_raw.json
**/config_raw.json

# Production module-signing private keys — never commit (lives in Vault: secret/lantern_cloud/spark)
*.pkcs8
