# Rust build output
/target
/spark-sharing/target
# `wasm-server` is its own workspace (see Cargo.toml), so it has its own build dir that the
# root-anchored `/target` above does not cover.
/wasm-server/target
**/*.rs.bk

# Release packaging output (DMGs, tarballs, etc. — built by packaging/ scripts + CI)
/dist

# Cargo.lock is intentionally tracked: this workspace ships binaries, not just a library.

# Live fetched config with real secrets — copied in for manual transport diagnostics, never commit.
config_raw.json
**/config_raw.json

# Production module-signing private keys — never commit (lives in Vault: secret/lantern_cloud/spark)
*.pkcs8

# Android demo harness: a scratch app for on-device checks, not part of the build.
# Its Gradle outputs (an APK, the jniLibs .so pair, build caches) and `local.properties`
# (a machine-local `sdk.dir`) were committed once by a too-broad `git add`; ~18 MB of
# binaries and one developer's filesystem layout. Ignored so it cannot happen again.
platforms/android/demo/

# Gradle's own scratch state (caches, lock files, build-output bookkeeping). Machine-local
# and regenerated on every build; committed once by the same over-broad `git add` that took
# the demo tree.
.gradle/
