<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the entire screen: no platform ActionBar, and a light status bar that
         blends with the app's #F8FAFB top bars (dark status-bar icons). -->
    <style name="Theme.Spark" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F8FAFB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F8FAFB</item>
    </style>
</resources>
