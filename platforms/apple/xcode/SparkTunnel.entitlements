<?xml version="1.0" encoding="UTF-8"?>
<!-- Entitlements for the Packet Tunnel Provider SYSTEM EXTENSION (Developer ID + notarized path).
     `packet-tunnel-provider-systemextension` is the system-extension flavor (vs the App-Store
     `packet-tunnel-provider`). Sandbox off + network client/server, mirroring lantern's
     production PacketTunnel.entitlements. The entitlement is authorized by a Developer-ID
     provisioning profile (auto-created under team ACZRKC3LQ9). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider-systemextension</string>
    </array>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.org.getlantern.spark</string>
    </array>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
