<?xml version="1.0" encoding="UTF-8"?>
<!-- Entitlements for the container app. It both INSTALLS the system extension
     (system-extension.install) and MANAGES the VPN (networkextension + NETunnelProviderManager),
     so it carries the systemextension NE entitlement too; shares config via the App Group. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider-systemextension</string>
    </array>
    <key>com.apple.developer.system-extension.install</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.org.getlantern.spark</string>
    </array>
</dict>
</plist>
