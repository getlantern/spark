<?xml version="1.0" encoding="UTF-8"?>
<!-- Tauri controlling-app entitlements (Model A, ADR 0005): the Spark app INSTALLS the
     org.getlantern.spark.tunnel system extension (system-extension.install) and MANAGES the VPN
     (networkextension + NETunnelProviderManager), sharing config via the App Group. Same set as
     gui/macos/Runner/Release.entitlements and platforms/apple's SparkApp.entitlements, authorized by
     the "Spark macOS App" provisioning profile (47D77D). Unsandboxed (Developer ID, not App Store);
     hardened runtime is applied at sign time. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider-systemextension</string>
	</array>
	<key>com.apple.developer.system-extension.install</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.getlantern.spark</string>
	</array>
</dict>
</plist>
